# Rust / Anchor build output.
#
# Unlike the old repo, NOTHING under target/ is re-included. The old repo committed
# its program-identity keypair at target/deploy/<program>-keypair.json so every deploy
# reused the same program ID; that keypair then had to be treated as compromised.
# Blotto Cup keeps the program keypair OUTSIDE the repository — held by the operator, never
# committed — and pins the program ID in Anchor.toml and declare_id! instead.
/target/
**/target/
**/*.rs.bk

# Anchor
.anchor
.surfpool
test-ledger
.validator-ledger*

# Keys — never committed, in any form. The pre-commit hook in .githooks/pre-commit
# additionally rejects any staged file containing a 64-integer array (the Solana
# keypair JSON shape), wherever it lives.
keys/
keys/*.json
*.pem
*keypair*.json
id.json

# Secrets scan output
pre-scan.json
gitleaks.json

# Environment — only .env.example is tracked, and it carries names with no values.
.env
.env.local
.env.*.local

# Node
node_modules
.next
dist
coverage
*.tsbuildinfo

# Vercel CLI project linkage (holds org/project ids; never tracked)
.vercel/

# macOS
.DS_Store

# Editor
.idea
*.swp
*.swo

# Logs
*.log

# App build output
app/.next
*.tsbuildinfo

# Generated screenshot sets (npm run capture) — delivered as a zip, not committed.
app/screens/

# Founder design-handoff folder (reference inputs + fetched assets) — never committed.
handoff/

# A stray vitest/playwright last-run artifact. app/.gitignore already ignores
# its own; the ROOT copy escaped that and was committed reading
# {"status":"failed","failedTests":[]} — a red status naming no test, which is
# worse than no file at all (found 2026-09-16).
/test-results/
