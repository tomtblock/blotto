# indexer service image (E5). Build FROM THE REPO ROOT:
#   docker build -f deploy/docker/Dockerfile.indexer -t blotto-indexer .
# The backend packages cross-import by relative path, so every image
# carries the full backend tree + the founder-owned config/ files; each
# package gets its own npm ci (the repo's per-package layout, no hoisting).
FROM node:22-slim

# Which commit this image was built from. Two incidents on 2026-08-31
# came from a green deploy shipping code older than the fix, and neither
# was visible from outside the container. A service that names its own
# commit at startup answers that question directly.
ARG BLOTTO_BUILD_COMMIT=unknown
ENV BLOTTO_BUILD_COMMIT=$BLOTTO_BUILD_COMMIT

WORKDIR /app
COPY backend backend
COPY config config

RUN for d in backend/_shared backend/scoring backend/sealing backend/packet backend/reveal backend/detection backend/indexer; do \
      (cd "$d" && npm ci --no-audit --no-fund); \
    done

WORKDIR /app/backend/indexer
EXPOSE 8080 8081
CMD ["npx", "ts-node", "--transpile-only", "src/index.ts", "sync"]
