# review service image (E5). Build FROM THE REPO ROOT:
#   docker build -f deploy/docker/Dockerfile.review -t blotto-review .
# The backend packages cross-import by relative path, so every image
# carries the full backend tree + the founder-owned config/ files; each
# package gets its own npm ci (the repo's per-package layout, no hoisting).
# Pinned by digest (scanner triage 2026-10-11, item D): a tag can move under a
# rebuild; a digest cannot. The tag stays beside it for readers and for
# Dependabot (.github/dependabot.yml), which proposes each new digest as a
# reviewed change — an un-refreshed pin would stop receiving Debian and Node
# security fixes, which is worse than the tag. This is the multi-platform index
# of node:22-slim as of 2026-10-11 (linux/amd64 among its platforms).
FROM node:22-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

# Which commit this image was built from. Two incidents on 2026-08-31
# came from a green deploy shipping code older than the fix, and neither
# was visible from outside the container. A service that names its own
# commit at startup answers that question directly.
ARG BLOTTO_BUILD_COMMIT=unknown
ENV BLOTTO_BUILD_COMMIT=$BLOTTO_BUILD_COMMIT

# E-22 (audit 2026-09-11): this image used to run as root, and two of the four
# decode the settlement signer into shared memory at boot. Root inside a
# container is not root on the host, but it removes the last barrier between a
# remote-code bug in a public-facing Node service and everything else in the
# container — the decoded signing key among it. The `node:22-slim` base already
# ships an unprivileged `node` user (uid 1000); the tree is copied to it, the
# per-package installs run as it, and nothing here needs a port below 1024.
#
# The entrypoint writes the decoded keypair to /dev/shm, which is mode 1777 in
# a container, so it lands owned by `node` with umask 077 — strictly tighter
# than the root-owned file it replaces.
WORKDIR /app
RUN chown node:node /app
COPY --chown=node:node backend backend
COPY --chown=node:node config config
COPY deploy/docker/entrypoint-settlement.sh /usr/local/bin/entrypoint-settlement
RUN chmod +x /usr/local/bin/entrypoint-settlement

USER node

RUN for d in backend/_shared backend/scoring backend/sealing backend/packet backend/reveal backend/detection backend/indexer; do \
      (cd "$d" && npm ci --no-audit --no-fund); \
    done

WORKDIR /app/backend/detection
EXPOSE 8083
# The settlement keypair arrives as a base64 secret and is decoded to tmpfs
# at boot (see the entrypoint). It refuses to start without it.
ENV SERVICE_NAME=review
ENTRYPOINT ["/usr/local/bin/entrypoint-settlement"]
CMD ["npx", "ts-node", "--transpile-only", "src/main.ts"]
