# Blotto Cup backend services — environment variable NAMES, no values (E1).
#
# Every variable a backend package reads is listed here; the CI check
# (scripts/check-env-examples.sh) fails the build if code reads a variable
# this file does not list. Real values live in the hosting provider's
# secret manager — never in this repository, never in chat.
#
# One file for all services deliberately: they share the loader
# (backend/_shared/src/config.ts) and deploy from one runbook
# (docs/hosting.md). Each service reads only its own section.

# ---- Shared (every service) ------------------------------------------------

# Postgres connection string (defaults to the local docker-compose dev DB).
BLOTTO_DATABASE_URL=
# Max pool connections (default 10).
BLOTTO_DB_POOL_MAX=
# Monitor sink: where alerts and metrics go. Exactly one of "logging",
# "silent" or "prometheus" (case-insensitive); unset or empty = "logging",
# which is the development value and needs no network. Anything else makes
# every service REFUSE to start, naming this variable
# (backend/_shared/src/monitor.ts). Corrected 2026-09-12 from the documented
# value "log", which the loader has never accepted — an operator following
# this file could not start a service (audit 2026-09-11, B-52). Deployment
# selects "prometheus" in deploy/fly/*.toml; nothing local needs to.
BLOTTO_MONITOR_SINK=

# HTTP hygiene (any service exposing an API):
BLOTTO_API_CORS_ORIGINS=
BLOTTO_API_RATE_LIMIT_ENABLED=
BLOTTO_API_RATE_LIMIT_RPM=
BLOTTO_API_RATE_LIMIT_BURST=
BLOTTO_API_RATE_LIMIT_RETRY_AFTER_SECONDS=
BLOTTO_API_SECURITY_HEADERS_ENABLED=

# ---- Indexer ---------------------------------------------------------------

# RPC endpoint for backfill (Helius devnet/mainnet URL).
BLOTTO_RPC_URL=

# Which Solana cluster the services run against: "devnet" (the default when
# unset) or exactly "mainnet". On mainnet BLOTTO_RPC_URL is REQUIRED — there
# is no public mainnet fallback — and a URL that looks like the other cluster
# is refused at startup (backend/_shared/src/cluster.ts).
BLOTTO_CLUSTER=
# The program id to index (must match declare_id!).
BLOTTO_PROGRAM_ID=
# Webhook port (default 8080), read-API port (default 8081), ingest
# commitment (default finalized).
BLOTTO_INDEXER_PORT=
BLOTTO_READ_API_PORT=
BLOTTO_INDEXER_COMMITMENT=
# Shared secret the Helius webhook must present (Authorization header) —
# creation settings documented in docs/hosting.md (E6). The DAEMON reads the
# same variable to authorise its bundle announce (see the reveal section).
BLOTTO_HELIUS_WEBHOOK_SECRET=
# The address the daemon uploads published bundles from — the public key of
# the wallet behind IRYS_UPLOAD_KEY (audit 2026-09-11, C-25). OPTIONAL, and
# only the archive backfill's last-resort gateway query uses it: the normal
# path reads the daemon's own `published_bundles` row. Unset, that query is
# SKIPPED rather than widened, because asking the gateway for anything
# wearing our tags is the forgery route the filter exists to close.
BLOTTO_IRYS_UPLOAD_ADDRESS=
# How often the SERVING indexer walks the chain for deliveries the webhook
# never brought, in milliseconds (audit 2026-09-11, C-11 / C-21). Default
# 900000 (fifteen minutes); 0 disables it, which leaves a dropped delivery
# below the ingest watermark missing until someone runs `backfill` by hand.
# A healthy run costs one signature page and no transaction fetches, because
# the walk asks the ledger what it already has before fetching anything.
BLOTTO_RECONCILE_INTERVAL_MS=

# ---- Packet service (entry gate) ------------------------------------------

# Turnkey API credentials for the sign-only entry signer (C11):
TURNKEY_API_BASE_URL=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
# The entry signer inside Turnkey: private-key id + its Ed25519 public key.
ENTRY_SIGNER_KEY_ID=
ENTRY_SIGNER_PUBLIC_KEY_HEX=

# Local/dev geo stub (the vendor adapter replaces this in production; R2):
GEO_STUB_COUNTRY=
GEO_STUB_REGION=
GEO_STUB_VPN=

# The packet service's deployment entry (E5, src/main.ts):
# port (default 8082), config paths (default config/*.json), and the
# trust-proxy switch ("1" ONLY behind our own proxy).
BLOTTO_PACKET_PORT=
BLOTTO_TERRITORIES_PATH=
BLOTTO_TERMS_PATH=
BLOTTO_TRUST_PROXY=
# Production geo vendor (R2) — the stub above is dev-only.
GEO_VENDOR_URL=
GEO_VENDOR_API_KEY=
# Dev/rehearsal entry signer: 32-byte hex seed (production uses Turnkey).
ENTRY_SIGNER_SEED_HEX=

# ---- Review service (C10, src/main.ts) --------------------------------------

# Port (default 8083) and the founder-owned reviewer registry path.
BLOTTO_REVIEW_PORT=
BLOTTO_REVIEWERS_PATH=
# Path to the settlement keypair JSON — executes flag / clear / release, and
# in the daemon also reveal / commit / pay / pay-next-place. It CANNOT
# forfeit: since 2026-09-07 `forfeit_escrow` is admin-signed, so the review
# service holds no key that can take a prize away. The same file is the
# daemon's signer below; keeping one key in two services is recorded as an
# open item in docs/AUDIT-2026-09-07.md.
SETTLEMENT_SIGNER_KEYPAIR=

# The shared operator secret for GET /detection — the reviewer's page reads
# the persisted detection report through it (founder ruling D-E9, audit
# A-18). UNSET closes that route with a 503 rather than opening it: the
# report names players a signal fired on before any human has looked at them,
# so it fails closed and the service warns at boot. Send it as the
# `authorization` header, exactly as the indexer's ingress takes its secret.
# It is an OPERATOR secret: it must not reach the browser bundle (no
# NEXT_PUBLIC_ variable), so the admin page reads it through a server-side
# route of its own.
BLOTTO_REVIEW_OPERATOR_TOKEN=
# The per-reviewer action budget (audit B-25): how many signed decisions ONE
# reviewer key may make per window, and how long that window is in ms.
# Unset = the architect proposals in backend/detection/src/budget.ts (64 per
# hour — one pool's worth of seats), which are AWAITING_RATIFICATION: the
# number is founder-owned. Exceeding it is a 429 and a loud alert.
BLOTTO_REVIEW_ACTION_BUDGET=
BLOTTO_REVIEW_ACTION_WINDOW_MS=

# ---- Sealing custody (pool keys, C11) --------------------------------------

# Same Turnkey org as above, plus the API user that imports/exports keys.
TURNKEY_USER_ID=

# ---- Reveal daemon (crank + keeper) ----------------------------------------

# The funded Solana wallet (base58 secret key) that pays Irys uploads, and
# which Irys network to use. LEAVE IRYS_NETWORK UNSET to follow BLOTTO_CLUSTER
# — that is the safe default. If it is set it must be exactly "devnet" or
# "mainnet" AND must name the same cluster, or the daemon refuses to start
# (audit 2026-09-11, E-12): a bundle published to the wrong storage network
# cannot be moved and cannot be republished under the same identifier.
IRYS_UPLOAD_KEY=
IRYS_NETWORK=
# The daemon's deployment entry (E5, src/main.ts): tick interval (default
# 15000ms), health port (default 8084), and the VRF coordinator — set
# SWITCHBOARD_QUEUE (the On-Demand queue pubkey for the target cluster) for
# the production coordinator, or RANDOMNESS_ACCOUNT (a fixed Randomness
# account) for the tests/bench stub. One of the two is required.
BLOTTO_DAEMON_INTERVAL_MS=
BLOTTO_DAEMON_HEALTH_PORT=
SWITCHBOARD_QUEUE=
RANDOMNESS_ACCOUNT=
# Optional: a separate keeper keypair path when `open_pool`'s key
# (Config.keeper) is split from the settlement signer. Unset = the settlement
# signer opens pools — the devnet posture until E6 splits the keys.
KEEPER_KEYPAIR=
# Where the daemon tells the indexer a settled pool's bundle is: POST
# /bundles on the indexer's webhook service (port 8080), authorised with the
# indexer's own BLOTTO_HELIUS_WEBHOOK_SECRET (listed under Indexer). Both set
# = announce ON. Either unset = OFF: warned at boot on devnet (the archive
# then fills only when indexer-backfill.yml runs archive-backfill, daily) and
# REFUSED on mainnet. Staged by deploy-backend.yml (audit 2026-09-11, D-02).
BLOTTO_INDEXER_ANNOUNCE_URL=
# The unreadable-entry ceiling (audit 2026-09-11, B-08): how many entries may
# fail to read back from the ciphertext store before the crank refuses to
# settle the pool. FOUNDER-OWNED value (plan 2026-09-12 §2e). Unset on devnet
# = the crank's default (all but one), printed at boot; REQUIRED on mainnet —
# the daemon refuses to start without it. Staged from the repository variable
# of the same name by deploy-backend.yml.
BLOTTO_MAX_UNREADABLE_ENTRIES=

# ---- Deploy / admin (scripts/, not a service) ------------------------------

# Path to the program keypair for deploys (scripts/deploy-devnet.sh).
BLOTTO_PROGRAM_KEYPAIR=
# Path to the keypair that pays for the deploy and holds the upgrade
# authority (the devnet fee payer until runbook C4). Named explicitly since
# 2026-09-12; the script refuses to run without it.
BLOTTO_DEPLOY_KEYPAIR=
# Path to the fee-payer keypair the devnet admin CLI signs with (E3;
# devnet-only stand-in for the Squads vault).
FEE_PAYER_KEYPAIR=

# The settlement keypair as base64 of the keypair JSON (`base64 -w0 < kp.json`).
# Fly hands secrets as env values, but the daemon and review services read
# SETTLEMENT_SIGNER_KEYPAIR as a PATH — deploy/docker/entrypoint-settlement.sh
# decodes this into tmpfs at boot and exports the path. C6 option (a), the
# devnet interim that Turnkey custody supersedes. Set one or the other.
SETTLEMENT_SIGNER_KEYPAIR_B64=

# Deliberate opt-in for the DEVELOPMENT entry signer. The packet service
# refuses to start on ENTRY_SIGNER_SEED_HEX unless this is exactly "1", so an
# absent ENTRY_SIGNER_KEY_ID can never silently downgrade a Turnkey
# deployment to the development key (devnet incident, 2026-08-29).
ALLOW_DEV_ENTRY_SIGNER=

# IPLocate tuning (R2 vendor of record). The free plan is a DAILY request cap
# over a finite, non-renewing credit balance, so a retry storm spends reserve
# rather than a free allowance: a 429 is never retried, and only transient
# faults (network, 5xx) are, within GEO_VENDOR_ATTEMPTS.
GEO_VENDOR_ATTEMPTS=
GEO_VENDOR_TIMEOUT_MS=
# Per-IP cache TTL in ms; 0 disables. Two lookups per entrant across 64
# entrants is 128 requests per pool without it. Changes no verdict — the
# territory decision is already a pure function of the address.
GEO_CACHE_TTL_MS=

# An optional SECOND geo source behind the same contract, asked only when the
# first cannot answer (out of credits, key refused, unreachable). With a
# single source a vendor outage still stops every entry — the startup line
# says so. Which vendor goes here is a founder call (R2).
GEO_VENDOR_2_URL=
GEO_VENDOR_2_API_KEY=
# Our OWN spending ceiling per 24 h across every geo call, set BELOW the
# vendor's plan cap. Unset = no ceiling (the behaviour before 2026-09-12).
# GET /geo is unauthenticated and costs one lookup per unseen address, so
# without this a few thousand page views could spend the whole balance and
# refuse every entry until the vendor reset (audit 2026-09-11, B-04).
GEO_DAILY_CAP=
# Of that ceiling, how many lookups only POST /packet may spend. The
# pre-flight stops at GEO_DAILY_CAP minus this, so a flood of page views
# cannot starve a paying entrant. Default: a quarter of GEO_DAILY_CAP.
GEO_ISSUANCE_RESERVE=

# Set by the Docker build (--build-arg from deploy-backend.yml), not by hand.
# Each service prints it as its first startup line so "which code is running"
# is answerable from the logs rather than by comparing a commit on a web page
# against a branch — the cause of both 2026-08-31 deploy incidents.
BLOTTO_BUILD_COMMIT=

# ---- Sanctions screening (Phase 2, @blotto/sanctions) ----------------------
# Consumed by the packet service at entry (Stage B) and by the daemon at
# resolving (Stage F). The selector (backend/sanctions/src/select.ts) refuses
# to start a service with none of these set — packets are never issued
# unscreened. Any combination of the three sources composes; a match from any
# lists the address, and a source that fails is disclosed in the verdict.
#
# Chainalysis Sanctions Screening API (primary): the free per-address key.
SANCTIONS_CHAINALYSIS_API_KEY=
# OpenSanctions /match (cross-check): "Authorization: ApiKey <key>".
SANCTIONS_OPENSANCTIONS_API_KEY=
# The locally mirrored OFAC SDN list (fallback): "1" enables it. Fetched from
# the Sanctions List Service SDN.XML export unless a local file is given; a
# mirror older than the max age refuses to answer rather than say "clean".
SANCTIONS_OFAC_SDN=
SANCTIONS_OFAC_SDN_URL=
SANCTIONS_OFAC_SDN_PATH=
SANCTIONS_OFAC_MAX_AGE_HOURS=
# Per-address verdict cache in ms (default 900000; 0 disables). Never caches a
# failure; keys on the address alone.
SANCTIONS_CACHE_TTL_MS=
# DEVELOPMENT stub: comma-separated addresses to treat as listed (an empty
# value means nobody). Refused unless ALLOW_STUB_SANCTIONS=1, exactly as the
# dev entry signer needs ALLOW_DEV_ENTRY_SIGNER — absent vendor keys must never
# silently mean "screen against nothing".
SANCTIONS_STUB_LISTED=
ALLOW_STUB_SANCTIONS=

# ---- Found by the widened env gate (audit 2026-09-11, A-09 / E-07 / D-38) --
# Appended 2026-09-12, when scripts/check-env-examples.sh learned to see the
# backend's dominant read shape (`env.NAME`) and not just `process.env.NAME`.

# Deliberate opt-in for the DEVELOPMENT geo stub, exactly as the dev entry
# signer needs ALLOW_DEV_ENTRY_SIGNER and the sanctions stub needs
# ALLOW_STUB_SANCTIONS (audit 2026-09-11, E-03 / C-31). The packet service
# REFUSES to start on GEO_STUB_COUNTRY unless this is exactly "1", so a vendor
# key rotated or cleared out of band can never silently downgrade a paid
# deployment to a stub that answers every address with one country. Staged by
# deploy-backend.yml only on the allow_dev_credentials path, and cleared on
# the vendor path.
ALLOW_STUB_GEO=

# The port each service exposes its Prometheus exposition on — the metrics
# listener binds it ONLY when BLOTTO_MONITOR_SINK selects "prometheus", and
# only on the private network; it is never the platform's routed port.
# Default 9090 (backend/_shared/src/metrics-listener.ts), which
# deploy/fly/*.toml sets explicitly. The gate sees this one through its
# DECLARATION rather than its read site: the name is bound to a constant and
# passed to `portEnv(env, METRICS_PORT_ENV)`, which no pattern over the read
# can see through.
BLOTTO_METRICS_PORT=
