{
  "name": "@blotto/watch",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "The failure-only watcher (decision R23): probes the services, the chain, the site and the CI lanes from outside, and tells the founders' Telegram group when something breaks — and only then.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/main.ts",
  "scripts": {
    "start": "ts-node --transpile-only src/main.ts",
    "test": "ts-mocha -p ./tsconfig.json -t 60000 \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.0.5",
      "js-yaml": "^4.3.2",
      "minimatch@4": "^4.2.6",
      "nanoid": "^3.3.18",
      "diff": "^5.2.2",
      "chokidar": "^4.0.3"
    },
    "brace-expansion@1": "^1.1.21"
  }
}
