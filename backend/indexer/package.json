{
  "name": "@blotto/indexer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Off-chain event indexer. Ingests the blotto_cup program's on-chain events via webhook deliveries and an RPC backfill walk, into a Postgres event ledger. The canonical off-chain event store the reveal, scoring, claim and detection pipelines read from.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 60000 \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/index.ts migrate",
    "serve": "ts-node src/index.ts serve",
    "backfill": "ts-node src/index.ts backfill",
    "re-derive": "ts-node src/index.ts re-derive",
    "sync": "ts-node src/index.ts sync"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@solana/web3.js": "^1.95.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  }
}
