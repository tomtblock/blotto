    "node": ">=20"
  },
  "main": "src/index.ts",
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 60000 \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "vectors": "python3 fixtures/gen_vectors.py --write"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "esbuild": "^0.28.2",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.0.5",
      "js-yaml": "^4.3.2",
      "minimatch@4": "^4.2.6",
      "nanoid": "^3.3.18",
      "diff": "^5.2.2",
      "chokidar": "^4.0.3"
    },
    "brace-expansion@1": "^1.1.21"
