{
  "name": "@blotto/battle-test",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Devnet battle-test tooling (see MANUAL.md). Imports backend/scoring, backend/sealing, backend/packet and tests/rehearsal by relative path as read-only libraries; modifies nothing under app/, programs/, backend/ or tests/.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "keys": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\",\"moduleResolution\":\"node\"} scripts/keys.ts",
    "registry": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\",\"moduleResolution\":\"node\"} scripts/registry.ts",
    "fan-out": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\",\"moduleResolution\":\"node\"} scripts/fan-out.ts",
    "enter": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\",\"moduleResolution\":\"node\"} scripts/enter.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^4.0.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "^5.0.0"
    }
  }
}
