# Blotto Cup app (Next.js) — environment variable NAMES, no values (E1).
#
# Every variable here is read somewhere under app/src; the CI check
# (scripts/check-env-examples.sh) fails the build if code reads a variable
# this file does not list. Real values live in the hosting provider's
# secret manager (Vercel project settings — docs/guide/HOSTING.md), never
# in this repository.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle — nothing
# secret may ever use that prefix.

# The deployed program id (must match declare_id!, currently 5aawXayPYgEqrnHi6pGiYRpuHNuwauj8GqftRjkeXH17).
NEXT_PUBLIC_PROGRAM_ID=

# Solana RPC endpoint the browser uses (Helius or public devnet RPC).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Which Solana cluster this build is for: "devnet" (the default when unset)
# or exactly "mainnet". Drives the provider chain id, the RPC fallback, the
# explorer links and the funding method. A mainnet build has NO fallback RPC
# and refuses to build with the faucet link or the automation signer on
# (app/src/chain/cluster.ts, asserted by cluster.test.ts). Never set mainnet
# on a preview.
NEXT_PUBLIC_SOLANA_CLUSTER=
# C7/B-e: set to 1 ONLY for a driven devnet browser (Stage D 5.1). It admits
# a keypair-backed signer injected at window.__BLOTTO_TEST_SIGNER__, bypassing
# the wallet extension and the Privy modals. Unset everywhere else: with it
# unset the code is eliminated from the production bundle, which the
# app-test-signer CI lane asserts by grepping a real build. Refuses to act
# unless NEXT_PUBLIC_SOLANA_RPC_URL names devnet (or is unset).
NEXT_PUBLIC_ALLOW_TEST_SIGNER=

# The indexer read API base URL (GET /pools, /treasury, /history/*).
# Without it a development build serves the in-repo fixture catalogue and a
# PRODUCTION build serves nothing at all: every read fails and each page
# renders its "live data unavailable" state (audit 2026-09-11, A-07 — a
# deploy that forgot this variable used to serve fabricated tournaments,
# with an Enter button, to real visitors).
NEXT_PUBLIC_INDEXER_URL=

# Set to 1 ONLY to screenshot a production build with no backend (the
# Playwright journey suite, app/playwright.config.ts). It puts the in-repo
# fixture tournaments back into a production build, which is why it must
# never be set on a deploy players can reach: exactly "1" enables, unset is
# normalised to "0" at build time, and the cluster gate REFUSES to build a
# mainnet bundle with it on.
NEXT_PUBLIC_FIXTURE_DATA=

# The entry-packet service base URL (POST /packet).
NEXT_PUBLIC_ENTRY_API_URL=

# The review service base URL (the admin review page's POSTs).
NEXT_PUBLIC_REVIEW_API_URL=

# The review service's OPERATOR token, for GET /detection (founder ruling
# D-E9: the detection report goes to the reviewer and nothing acts on it).
# SERVER-SIDE ONLY — deliberately not NEXT_PUBLIC_, because a NEXT_PUBLIC_
# variable is compiled into every visitor's bundle. The app's own
# /api/detection route holds it and proves the caller is a wallet on
# config/reviewers.json before using it; unset, that route answers 503 and
# the review page says the report is not configured. Never set this in a
# preview that shares a review service with production.
REVIEW_OPERATOR_TOKEN=

# Feature flag: the top-up prompt (D-C: ships OFF; exactly "1" enables —
# the code tests `=== '1'`, so "true" leaves it OFF with no error anywhere).
NEXT_PUBLIC_TOPUP_ENABLED=

# Devnet only: show a "get test SOL" faucet link on the wallet screen and the
# balance gate. No card or exchange provider sells devnet SOL, so without it
# a real person testing the site cannot get past the balance gate by any
# action available on the site. Exactly "1" enables; must be UNSET in any
# real-money build (asserted by the app's cluster tests).
NEXT_PUBLIC_DEVNET_FAUCET=

# Privy app credentials (login + embedded wallet).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Set by Next.js itself ("development" | "production" | "test") — never set
# it by hand. Listed because code reads it: next.config.ts uses it to decide
# whether the dev-only routes are built at all and whether the CSP allows the
# dev overlay's 'unsafe-eval', and the /dev pages 404 on it as a second layer.
# This file lists every variable the code reads.
NODE_ENV=

# ---- Pre-launch code gate (src/gate/gate.ts) -------------------------------

# The code a visitor types on /gate. Handed out by hand; not a secret in the
# cryptographic sense, but do not commit a real value.
GATE_CODE=
# Random 32-byte hex (`openssl rand -hex 32`). The value stored in the
# admission cookie — NOT the code. Rotating it logs everyone out.
GATE_COOKIE_SECRET=
# Comma-separated hosts to gate. Unset ⇒ blotto.gg,www.blotto.gg.
# Set to "localhost" to exercise the gate in local development.
GATE_HOSTS=
