# Blotto Cup app (Next.js) — environment variable NAMES, no values (E1).
#
# Every variable here is read somewhere under app/src; the CI check
# (scripts/check-env-examples.sh) fails the build if code reads a variable
# this file does not list. Real values live in the hosting provider's
# secret manager (Vercel project settings — docs/deploy-vercel.md), never
# in this repository.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle — nothing
# secret may ever use that prefix.

# The deployed program id (must match declare_id!, currently 5aawXayPYgEqrnHi6pGiYRpuHNuwauj8GqftRjkeXH17).
NEXT_PUBLIC_PROGRAM_ID=

# Solana RPC endpoint the browser uses (Helius or public devnet RPC).
NEXT_PUBLIC_SOLANA_RPC_URL=
# C7/B-e: set to 1 ONLY for a driven devnet browser (Stage D 5.1). It admits
# a keypair-backed signer injected at window.__BLOTTO_TEST_SIGNER__, bypassing
# the wallet extension and the Privy modals. Unset everywhere else: with it
# unset the code is eliminated from the production bundle, which the
# app-test-signer CI lane asserts by grepping a real build. Refuses to act
# unless NEXT_PUBLIC_SOLANA_RPC_URL names devnet (or is unset).
NEXT_PUBLIC_ALLOW_TEST_SIGNER=

# The indexer read API base URL (GET /pools, /treasury, /history/*).
NEXT_PUBLIC_INDEXER_URL=

# The entry-packet service base URL (POST /packet).
NEXT_PUBLIC_ENTRY_API_URL=

# The review service base URL (the admin review page's POSTs).
NEXT_PUBLIC_REVIEW_API_URL=

# Feature flag: the top-up prompt (D-C: ships OFF; exactly "1" enables —
# the code tests `=== '1'`, so "true" leaves it OFF with no error anywhere).
NEXT_PUBLIC_TOPUP_ENABLED=

# Devnet only: show a "get test SOL" faucet link on the wallet screen and the
# balance gate. No card or exchange provider sells devnet SOL, so without it
# a real person testing the site cannot get past the balance gate by any
# action available on the site. Exactly "1" enables; must be UNSET in any
# real-money build (asserted by the app's cluster tests).
NEXT_PUBLIC_DEVNET_FAUCET=

# Privy app credentials (login + embedded wallet).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Privy server-side secret (API routes only — never NEXT_PUBLIC).
PRIVY_APP_SECRET=

# Set by Next.js itself ("development" | "production" | "test") — never set
# it by hand. Listed because code reads it (/dev/components 404s outside
# development), and this file lists every variable the code reads.
NODE_ENV=
