# Environment variable NAMES the Android shell build reads — no values.
# The values live in the operator's password manager, never here and never
# in a committed file (the pattern app/.env.example follows).
#
# Read by `npx solana-mobile webshell build` (Solana Mobile CLI ≥ 0.5.0) so
# it does not prompt. Both are the passwords of the dApp Store signing key
# that `webshell init --keystore-path` created or was given.
SOLANA_MOBILE_KEYSTORE_PASSWORD=
# Defaults to the keystore password when unset.
SOLANA_MOBILE_KEY_PASSWORD=
