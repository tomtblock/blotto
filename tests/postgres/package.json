{
  "name": "@blotto/postgres-suite",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "The only suite in this repository that executes SQL. Runs the migrations against an EMPTY database and then drives every Postgres-backed store in the backend against the schema they produced (audit 2026-09-11, A-03 / G-03 / G-04 / G-17). Gated on BLOTTO_TEST_DATABASE_URL: without it every case is pending, never silently green.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 120000 \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.0.5",
      "js-yaml": "^4.3.2",
      "minimatch@4": "^4.2.6",
      "nanoid": "^3.3.18",
      "diff": "^5.2.2",
      "chokidar": "^4.0.3"
    },
    "brace-expansion@1": "^1.1.21"
  }
}
